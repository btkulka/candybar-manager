{
  "name": "candybar-manager",
  "version": "0.2.1",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "node scripts/run-electron-vite.mjs build",
    "start": "node scripts/run-electron-vite.mjs preview",
    "build:ts": "tsc",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "dist": "npm run build && npm run build:mcp && (electron-builder --mac --publish never; s=$?; npm run rebuild; exit $s)",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "web": "node scripts/run-electron-vite.mjs web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "csv-parse": "^5.5.6",
    "electron-log": "^5.4.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fuzzball": "^2.2.3",
    "jsdom": "^28.1.0",
    "music-metadata": "^10.7.4",
    "node-id3": "^0.2.9",
    "playwright": "^1.58.2",
    "soundcloud.ts": "^0.7.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "tar": "^7.5.10",
    "@tootallnate/once": "^3.0.1"
  },
  "devDependencies": {
    "@btkulka/electron-kit": "file:../packages/electron-kit",
    "@btkulka/proc-kit": "file:../packages/proc-kit",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.0.8",
    "concurrently": "^8.2.2",
    "electron": "^39.2.7",
    "electron-builder": "26.0.12",
    "electron-vite": "^5.0.0",
    "electronmon": "^2.0.3",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
